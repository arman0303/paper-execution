# LLM Configuration
# Options: "mock" (offline testing), "openai", "gemini"
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Embeddings & Reranker Configuration
# Options: "sentence-transformers" (local neural) or "tfidf" (zero-dependency fallback)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
ENABLE_RERANKER=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Database Configuration
DATABASE_URL=sqlite:///data/sample_ecommerce.db
DATABASE_DIALECT=sqlite

# ChromaDB Storage
CHROMA_PERSIST_DIRECTORY=chroma_storage

# Retrieval Thresholds (Configurable defaults aligned with paper empirical findings)
THRESHOLD_EXACT_MATCH=0.98
THRESHOLD_NORMALIZED_P95=0.92
THRESHOLD_MAIN_CLAUSE_P99=0.88
THRESHOLD_EXPANDED_P01=0.75
THRESHOLD_RERANKER=0.50

# Pipeline Settings
ENTITY_VOTING_ROUNDS=3
ENTITY_VOTING_MIN_FREQUENCY=2
PARAPHRASE_COUNT=3
MAX_EXECUTION_TIMEOUT_SECONDS=5
MAX_EXECUTION_ROWS=100
MAX_SQL_CORRECTION_ATTEMPTS=2
